# URL propres du site one-page Carré d'Hôtes (hébergement OVH / Apache)
#
# Le site reste une seule page : index.html à la racine du dépôt.
# Les adresses /offres, /reservation, /simulateur… servent index.html
# SANS changer l'URL affichée ; le JavaScript de la page lit le chemin
# et affiche la section ou la vue correspondante.
# Les liens internes et la navigation utilisent l'API History :
# aucun rechargement, l'URL propre est mise à jour à chaque clic.
# Les anciens liens en /#offres, /#reservation… continuent de fonctionner :
# l'ancre est interprétée par la page puis convertie en URL propre.

RewriteEngine On

# Cas du slash final (/offres/) : AUCUNE redirection — vérifié le
# 31/10/2026 sur cet hébergement mutualisé OVH, une redirection relative
# (R=301) exposait le chemin interne du serveur (/homez.…) et finissait
# en 404. À la place, réécriture interne en deux temps :
# 1) les assets demandés sous la route (/offres/assets/…) sont ramenés
#    à leur vrai emplacement ;
RewriteRule ^(accueil|logements|methode|offres|simulateur|temoignages|faq|contact|reservation)/(assets/.+)$ $2 [L]

# 2) Servir la page unique pour chaque route propre, slash final accepté.
# (Les fichiers et dossiers réels — assets, images… — ne correspondent
# pas à ces noms et ne sont donc pas affectés.)
RewriteRule ^(accueil|logements|methode|offres|simulateur|temoignages|faq|contact|reservation)/?$ index.html [L]
